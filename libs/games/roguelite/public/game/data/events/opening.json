{
  "note": "오프닝 v1 (기획 24_opening-script-v1). 형식: docs는 events/README.md. 명령 하나 = { \"cmd\": 이름, ...인자 }, 시간 ms.",
  "speakers": {
    "companion": { "name": "빛", "color": "#fff1c8" }
  },
  "rooms": {
    "opening-wake": [
      {
        "id": "wake",
        "trigger": { "type": "roomStart" },
        "do": [
          { "cmd": "lockInput" },
          { "cmd": "light.ambient", "to": 0, "ms": 0 },
          { "cmd": "light.tween", "target": "ember", "radius": 0, "ms": 0 },
          { "cmd": "wait", "ms": 1500 },
          { "cmd": "bgm", "id": "bgm-part0", "fadeMs": 6000 },
          { "cmd": "light.tween", "target": "ember", "radius": 6, "ms": 120 },
          { "cmd": "light.tween", "target": "ember", "radius": 0, "ms": 200 },
          { "cmd": "wait", "ms": 700 },
          { "cmd": "light.tween", "target": "ember", "radius": 10, "ms": 150 },
          { "cmd": "light.tween", "target": "ember", "radius": 2, "ms": 250 },
          { "cmd": "wait", "ms": 500 },
          { "cmd": "light.tween", "target": "ember", "radius": 28, "ms": 900 },
          { "cmd": "async", "do": [{ "cmd": "light.ambient", "to": 0.12, "ms": 2000 }] },
          { "cmd": "wait", "ms": 600 },
          { "cmd": "unlockInput" }
        ]
      }
    ],
    "opening-glimmer": [
      {
        "id": "glimmer-appears",
        "trigger": { "type": "enterArea", "area": "m" },
        "do": [
          { "cmd": "light.spawn", "id": "far-glimmer", "at": "g", "color": "gold", "radius": 6 },
          { "cmd": "light.tween", "target": "far-glimmer", "radius": 10, "ms": 400 },
          { "cmd": "light.tween", "target": "far-glimmer", "radius": 4, "ms": 600 },
          { "cmd": "light.tween", "target": "far-glimmer", "radius": 9, "ms": 400 },
          { "cmd": "camera.pan", "toward": "far-glimmer", "px": 12, "ms": 700 },
          { "cmd": "wait", "ms": 500 },
          { "cmd": "camera.pan", "to": "player", "ms": 500 },
          { "cmd": "camera.follow", "target": "player" }
        ]
      },
      {
        "id": "glimmer-fades",
        "trigger": { "type": "enterArea", "area": "n" },
        "do": [
          { "cmd": "light.tween", "target": "far-glimmer", "radius": 0, "ms": 300 },
          { "cmd": "light.remove", "id": "far-glimmer" }
        ]
      }
    ],
    "opening-vista": [
      {
        "id": "artifact-rests",
        "trigger": { "type": "roomStart" },
        "do": [
          { "cmd": "spawn", "kind": "artifact", "id": "artifact", "at": "A" },
          { "cmd": "spawn", "kind": "prop", "id": "robe", "sprite": "prop-robe", "clip": "lie", "at": { "of": "artifact", "dy": 16 } }
        ]
      },
      {
        "id": "vista",
        "trigger": { "type": "enterArea", "area": "v" },
        "do": [
          { "cmd": "lockInput" },
          { "cmd": "move", "id": "player", "path": [{ "dy": -32 }], "speed": 40 },
          { "cmd": "wait", "ms": 400 },
          {
            "cmd": "parallel",
            "do": [
              { "cmd": "camera.pan", "to": "t", "ms": 3500 },
              { "cmd": "light.ambient", "to": 0.22, "ms": 3500 }
            ]
          },
          { "cmd": "wait", "ms": 2000 },
          { "cmd": "camera.pan", "to": "player", "ms": 1800 },
          { "cmd": "camera.follow", "target": "player" },
          { "cmd": "unlockInput" }
        ]
      },
      {
        "id": "form-change",
        "trigger": { "type": "interact", "target": "artifact" },
        "do": [
          { "cmd": "lockInput" },
          { "cmd": "parallel", "do": [{ "cmd": "light.ambient", "to": 0.08, "ms": 800 }, { "cmd": "move", "id": "player", "path": [{ "of": "artifact", "dy": 2 }], "speed": 30 }] },
          { "cmd": "sfx", "id": "form-merge" },
          { "cmd": "spawn", "kind": "prop", "id": "merge", "sprite": "fx-merge", "at": "artifact", "layer": "overlay", "light": { "radius": 14, "color": "warm" } },
          { "cmd": "parallel", "do": [{ "cmd": "move", "id": "player", "path": [{ "orbit": "artifact", "radius": 6, "turns": 2 }], "speed": 40 }, { "cmd": "light.tween", "target": "artifact", "radius": 32, "ms": 1100 }] },
          { "cmd": "bgm", "id": null, "fadeMs": 300 },
          { "cmd": "sfx", "id": "form-flash" },
          { "cmd": "highlight", "in": 250, "hold": 300, "out": 600 },
          { "cmd": "hide", "id": "player" },
          { "cmd": "despawn", "id": "merge" },
          { "cmd": "despawn", "id": "artifact" },
          { "cmd": "light.ambient", "to": 0.10, "ms": 0 },
          { "cmd": "spawn", "kind": "prop", "id": "staff", "sprite": "prop-crystal-staff", "clip": "drop", "at": { "of": "robe", "dx": 12, "dy": -2 }, "light": { "radius": 8, "color": "cold" } },
          { "cmd": "wait", "ms": 1000 },
          { "cmd": "anim", "id": "staff", "clip": "lie" },
          { "cmd": "wait", "ms": 1200 },
          { "cmd": "anim", "id": "staff", "clip": "shake" },
          { "cmd": "wait", "ms": 1200 },
          { "cmd": "spawn", "kind": "prop", "id": "wind", "sprite": "fx-wind", "at": { "of": "robe", "dx": -160, "dy": -6 }, "layer": "overlay" },
          { "cmd": "sfx", "id": "wind-gust" },
          { "cmd": "anim", "id": "robe", "clip": "flutter" },
          { "cmd": "async", "do": [{ "cmd": "move", "id": "wind", "path": [{ "dx": 320 }], "speed": 420 }, { "cmd": "despawn", "id": "wind" }] },
          { "cmd": "wait", "ms": 400 },
          { "cmd": "anim", "id": "robe", "clip": "form-a" },
          { "cmd": "wait", "ms": 1400 },
          { "cmd": "setForm", "form": "child", "quiet": true },
          { "cmd": "light.tween", "target": "player.handFlame", "radius": 0, "ms": 0 },
          { "cmd": "place", "id": "player", "at": "robe" },
          { "cmd": "show", "id": "player" },
          { "cmd": "despawn", "id": "robe" },
          { "cmd": "parallel", "do": [{ "cmd": "anim", "id": "staff", "clip": "rise" }, { "cmd": "move", "id": "staff", "path": [{ "dy": -10 }], "speed": 22 }] },
          { "cmd": "anim", "id": "staff", "clip": "fly" },
          { "cmd": "move", "id": "staff", "path": [{ "of": "player", "dx": -5, "dy": -12 }], "speed": 32 },
          { "cmd": "despawn", "id": "staff" },
          { "cmd": "wait", "ms": 700 },
          { "cmd": "sfx", "id": "handflame-ignite" },
          { "cmd": "async", "do": [{ "cmd": "light.ambient", "to": 0.3, "ms": 1500 }] },
          { "cmd": "light.tween", "target": "player.handFlame", "radius": 55, "ms": 1200 },
          { "cmd": "anim", "id": "player", "clip": "look-hands" },
          { "cmd": "wait", "ms": 1200 },
          { "cmd": "fade", "to": "out", "ms": 1200 },
          { "cmd": "wait", "ms": 800 },
          { "cmd": "goRoom", "room": "part1-meet" }
        ]
      }
    ],
    "part1-meet": [
      {
        "id": "first-meeting",
        "trigger": { "type": "roomStart" },
        "do": [
          { "cmd": "lockInput" },
          { "cmd": "fade", "to": "in", "ms": 1000 },
          { "cmd": "wait", "ms": 600 },
          { "cmd": "emote", "id": "player", "icon": "…", "ms": 1200 },
          { "cmd": "wait", "ms": 400 },
          { "cmd": "bgm", "id": "bgm-part1", "fadeMs": 2500 },
          { "cmd": "spawn", "kind": "companion", "id": "companion", "at": "c" },
          {
            "cmd": "move",
            "id": "companion",
            "path": [{ "of": "player", "dx": 30, "dy": -30 }, { "orbit": "player", "radius": 22, "turns": 0.5 }, { "of": "player", "dx": 20, "dy": -8 }],
            "speed": 160
          },
          { "cmd": "setBrightness", "id": "companion", "level": 3 },
          { "cmd": "say", "speaker": "companion", "text": "찾았다!" },
          { "cmd": "say", "speaker": "companion", "text": "와, 진짜다. 진짜 움직여!" },
          {
            "cmd": "parallel",
            "do": [
              { "cmd": "emote", "id": "player", "icon": "!", "ms": 900 },
              { "cmd": "move", "id": "player", "path": [{ "dx": -8 }], "speed": 60 }
            ]
          },
          { "cmd": "say", "speaker": "companion", "text": "아, 미안 미안. 놀랐어? 나도 놀랐어." },
          { "cmd": "say", "speaker": "companion", "text": "아까 그 파란 불, 너 맞지? 저 아래서 깜빡이던 거." },
          { "cmd": "emote", "id": "player", "icon": "…", "ms": 900 },
          { "cmd": "say", "speaker": "companion", "text": "…맞구나. 끄덕였지? 방금 끄덕였지?" },
          { "cmd": "emote", "id": "player", "icon": "…", "ms": 900 },
          { "cmd": "say", "speaker": "companion", "text": "좋아. 끄덕인 걸로 할게." },
          { "cmd": "say", "speaker": "companion", "text": "근데 넌 이름이 뭐야?" },
          { "cmd": "emote", "id": "player", "icon": "…", "ms": 1500 },
          { "cmd": "say", "speaker": "companion", "text": "모르는구나." },
          { "cmd": "say", "speaker": "companion", "text": "괜찮아. 나도 내 이름 몰라.{pause:400} 진짜로." },
          { "cmd": "say", "speaker": "companion", "text": "그럼 내가 지어 줄게!" },
          {
            "cmd": "parallel",
            "do": [
              { "cmd": "move", "id": "companion", "path": [{ "orbit": "player", "radius": 20, "turns": 1 }], "speed": 50 },
              { "cmd": "face", "id": "player", "toward": "companion" }
            ]
          },
          { "cmd": "say", "speaker": "companion", "text": "반짝이는데, 뭔지 모르겠고, 작고…{pause:300} 어디서 떨어져 나온 것 같아." },
          { "cmd": "say", "speaker": "companion", "text": "그래! 넌 '알 수 없는 조각'이야." },
          { "cmd": "say", "speaker": "companion", "text": "{pause:300}나처럼." },
          { "cmd": "emote", "id": "player", "icon": "?", "ms": 900 },
          { "cmd": "say", "speaker": "companion", "text": "왜, 멋있잖아." },
          { "cmd": "say", "speaker": "companion", "text": "자, 가자! 여기 엄청 넓어. 아래보다 훨씬!" },
          { "cmd": "say", "speaker": "companion", "text": "왜인지는 모르겠는데…{pause:400} 너랑 같이 가야 할 것 같아." },
          { "cmd": "unlockInput" },
          { "cmd": "setBrightness", "id": "companion", "level": 2 },
          { "cmd": "setFlag", "flag": "companion-joined" },
          { "cmd": "follow", "id": "companion" }
        ]
      },
      {
        "id": "vine-hint",
        "trigger": { "type": "failCount", "key": "vine-touch", "n": 3 },
        "do": [{ "cmd": "say", "speaker": "companion", "text": "그 손에 있는 거, 불이지? 저기에 대 봐!" }]
      },
      {
        "id": "idle-tease",
        "trigger": { "type": "idle", "ms": 20000 },
        "do": [{ "cmd": "say", "speaker": "companion", "text": "…자? 설마 자는 거야?" }]
      },
      {
        "id": "vine-burned",
        "trigger": { "type": "flag", "flag": "vine-burned" },
        "do": [
          { "cmd": "emote", "id": "companion", "icon": "!", "ms": 900 },
          { "cmd": "say", "speaker": "companion", "text": "우와! 봤어? 네가 했어!", "auto": 1500 }
        ]
      }
    ],
    "hub": [
      {
        "id": "hub-first",
        "trigger": { "type": "roomStart" },
        "do": [
          { "cmd": "lockInput" },
          { "cmd": "say", "speaker": "companion", "text": "와, 넓다! 길이 여러 갈래야." },
          { "cmd": "say", "speaker": "companion", "text": "저 문, 양쪽에 뭐가 비어 있네? 뭔가 채워 넣어야 하나 봐." },
          { "cmd": "unlockInput" }
        ]
      },
      {
        "id": "hub-vine-hint",
        "trigger": { "type": "failCount", "key": "vine-touch", "n": 3 },
        "do": [
          { "cmd": "say", "speaker": "companion", "text": "이 덩굴은 더 두껍네. 여러 번 쏴 봐!" }
        ]
      }
    ],
    "brazier-w": [
      {
        "id": "brazier-w-lit",
        "trigger": { "type": "flag", "flag": "brazier-w" },
        "do": [
          { "cmd": "emote", "id": "companion", "icon": "!", "ms": 700 },
          { "cmd": "say", "speaker": "companion", "text": "따뜻해…!" },
          { "cmd": "if", "flag": "brazier-n", "then": [{ "cmd": "say", "speaker": "companion", "text": "둘 다 켰다! 그 문, 이제 열렸을 거야. 가 보자!" }], "else": [{ "cmd": "say", "speaker": "companion", "text": "불이 아까 그 문 쪽으로 흘러가. 하나 더 어딘가 있을 거야!" }] }
        ]
      }
    ],
    "brazier-n": [
      {
        "id": "brazier-n-lit",
        "trigger": { "type": "flag", "flag": "brazier-n" },
        "do": [
          { "cmd": "emote", "id": "companion", "icon": "!", "ms": 700 },
          { "cmd": "say", "speaker": "companion", "text": "켜졌다!" },
          { "cmd": "if", "flag": "brazier-w", "then": [{ "cmd": "say", "speaker": "companion", "text": "둘 다 켰다! 그 문, 이제 열렸을 거야. 가 보자!" }], "else": [{ "cmd": "say", "speaker": "companion", "text": "불이 아까 그 문 쪽으로 흘러가. 하나 더 어딘가 있을 거야!" }] }
        ]
      }
    ],
    "mural": [
      {
        "id": "mural-react",
        "trigger": { "type": "interact", "target": "trace-mural" },
        "do": [
          { "cmd": "lockInput" },
          { "cmd": "say", "speaker": "companion", "text": "이거… 글자야? 하나도 모르겠다." },
          { "cmd": "say", "speaker": "companion", "text": "근데 그림은 예쁘다. 사람들이 빛을 둘러싸고 있어." },
          { "cmd": "unlockInput" }
        ]
      }
    ],
    "shrine": [
      {
        "id": "pillar-get",
        "trigger": { "type": "interact", "target": "pedestal" },
        "do": [
          { "cmd": "lockInput" },
          { "cmd": "emote", "id": "companion", "icon": "!", "ms": 700 },
          { "cmd": "say", "speaker": "companion", "text": "어? 손에 불이 하나 더 생겼어!" },
          { "cmd": "say", "speaker": "companion", "text": "이것저것 섞어 봐! 왼쪽, 오른쪽, 막!" },
          { "cmd": "hint", "id": "pillar" },
          { "cmd": "unlockInput" }
        ]
      }
    ],
    "room-3": [
      {
        "id": "arena-lock",
        "trigger": { "type": "roomStart" },
        "do": [
          { "cmd": "lockRoom" },
          { "cmd": "say", "speaker": "companion", "text": "어, 문이 잠겼어!" }
        ]
      },
      {
        "id": "arena-open",
        "trigger": { "type": "flag", "flag": "cleared" },
        "do": [
          { "cmd": "unlockRoom" },
          { "cmd": "say", "speaker": "companion", "text": "휴… 다 멈췄다.", "auto": 1500 }
        ]
      },
      {
        "id": "crack-open",
        "trigger": { "type": "flag", "flag": "crack-room3" },
        "do": [
          { "cmd": "emote", "id": "companion", "icon": "!", "ms": 700 },
          { "cmd": "say", "speaker": "companion", "text": "우와, 벽이 무너졌어! 안에 뭐가 있나 봐.", "auto": 1500 }
        ]
      }
    ],
    "crack": [
      {
        "id": "crack-react",
        "trigger": { "type": "interact", "target": "trace-crack" },
        "do": [
          { "cmd": "lockInput" },
          { "cmd": "say", "speaker": "companion", "text": "{pause:400}…이상하다. 이 무늬, 어디서 본 것 같은데.{dim}" },
          { "cmd": "wait", "ms": 600 },
          { "cmd": "setBrightness", "id": "companion", "level": 2 },
          { "cmd": "say", "speaker": "companion", "text": "에이, 몰라! 가자!" },
          { "cmd": "unlockInput" }
        ]
      }
    ],
    "ante": [
      {
        "id": "ante-quiet",
        "trigger": { "type": "roomStart" },
        "do": [
          { "cmd": "wait", "ms": 800 },
          { "cmd": "say", "speaker": "companion", "text": "…여기, 조용하다.{dim}", "auto": 1500 },
          { "cmd": "say", "speaker": "companion", "text": "뭔가 큰 게 있어.", "auto": 1500 },
          { "cmd": "setBrightness", "id": "companion", "level": 2 }
        ]
      }
    ]
  }
}
